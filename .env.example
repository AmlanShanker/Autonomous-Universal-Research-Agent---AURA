# Select the primary LLM provider: groq (default) or adaption
LLM_PROVIDER=groq

# Optional secondary provider. Leave blank to disable fallback.
# Must be different from LLM_PROVIDER.
LLM_FALLBACK_PROVIDER=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Adaption Labs
ADAPTION_API_KEY=
ADAPTION_MODEL=

# Bounded LLM reliability controls
LLM_RETRY_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=30
LLM_RETRY_BACKOFF_SECONDS=0.5

# API security. Compose enforces authentication even if this local-development flag is false.
AURA_API_AUTH_ENABLED=false
# Use a unique random key of at least 32 characters for each API client.
# Keep this JSON value quoted in .env; never commit real keys.
AURA_API_KEYS='[{"id":"admin","key":"REPLACE_WITH_A_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS","role":"admin"}]'

# Fixed-window rate limiting per API key (or direct client IP before authentication)
AURA_API_RATE_LIMIT=120
AURA_API_RATE_WINDOW_SECONDS=60

# Structured logging level (DEBUG, INFO, WARNING, ERROR)
AURA_LOG_LEVEL=INFO


# Docker Compose deployment settings
# Generate the password with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# token_urlsafe output is safe to embed in the MongoDB URI without URL encoding.
MONGO_ROOT_USERNAME=aura
MONGO_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
MONGO_APP_USERNAME=aura_app
MONGO_APP_PASSWORD=REPLACE_WITH_A_RANDOM_TOKEN_URLSAFE_SECRET
MONGODB_DATABASE=aura
AURA_API_PORT=8000
# Bind to loopback by default; put a TLS reverse proxy in front of the API.
AURA_BIND_ADDRESS=127.0.0.1
